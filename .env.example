# Phase 1 で使う環境変数の雛形 (実値は .env.local に書く、コミットしない)
# 全項目 Phase 0 時点では未使用

# --- LLM (Anthropic) ---
# 本番プラン生成で使用 (Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Nominatim ---
# 公開連絡先メールを含めること (規約)
NOMINATIM_USER_AGENT=trip-guide/1.0 (you@example.com)

# --- Dev only ---
# fixtures/trips の JSON を本物の /api/generate の代わりに返す。
# 本番 Vercel には絶対セットしないこと
DEV_FIXTURE_MODE=
